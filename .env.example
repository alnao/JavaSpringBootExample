# Credenziali del profilo kube per il docker-compose.yml di root e per script/docker-run-kube-profile.sh
# (change openspec secret-kube). Copia questo file in .env (non versionato) e sostituisci TUTTI i valori:
#   cp .env.example .env
# Per generare i valori: openssl rand -hex 24   (esadecimale: niente caratteri da codificare in MONGODB_URI)
# Senza .env docker-compose si ferma indicando la variabile mancante.

# PostgreSQL (container e applicazione)
POSTGRES_USERNAME=gestioneannotazioni_user
POSTGRES_PASSWORD=cambiami-postgres

# MongoDB: utente root del container; l'applicazione riceve MONGODB_URI composto da questi due valori
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=cambiami-mongo

# mongo-express (basic auth dell'interfaccia web su http://localhost:8084)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=cambiami-mongo-express

# Chiave di firma dei token JWT (HS512: almeno 64 byte). Per generarla: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=cambiami-genera-con-openssl-rand-base64-64

# Password degli utenti creati al primo avvio (database vuoto); su un database gia' popolato non cambiano
APP_USER_ADMIN_PASSWORD=cambiami-admin
APP_USER_MODERATORE_PASSWORD=cambiami-moderatore
APP_USER_ALNAO_PASSWORD=cambiami-alnao
