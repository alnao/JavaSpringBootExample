# Credenziali dell'ambiente sqlite-locale (change openspec secret-sqlite).
# Copia questo file in .env (non versionato) e sostituisci TUTTI i valori:
#   cp .env.example .env
# Il file .env viene letto da docker-compose (env_file) e da rotate-secret.sh.

# Chiave di firma dei token JWT (HS512: almeno 64 byte). Per generarla:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=cambiami-genera-con-openssl-rand-base64-64

# Password degli utenti creati al primo avvio (database vuoto).
# Su un database gia' popolato non cambiano: vedi README, sezione sqlite-locale.
APP_USER_ADMIN_PASSWORD=cambiami-admin
APP_USER_MODERATORE_PASSWORD=cambiami-moderatore
APP_USER_ALNAO_PASSWORD=cambiami-alnao
